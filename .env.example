DATABASE_URL=
TEST_DATABASE_URL=
PORT=3000
# NODE_ENV: leave unset (or "production") on the host. Only "development" or "test" turn off Secure
# session cookies and proxy trust; `npm run dev` sets "development" itself.
NODE_ENV=
# TRUST_PROXY: how many reverse proxies sit in front of the app (a whole number, 0 or more).
# Unset means 1 in production and 0 in development. It must equal the real number of proxies:
# too low and every visitor shares one rate-limit key (ten bad sign-ins lock sign-in for everyone);
# too high and the app trusts an X-Forwarded-For value the client supplied (the limit can be dodged).
TRUST_PROXY=
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_NAME=
